# ─── Copia este fichero como .env y rellena los valores reales ───────────────
# cp .env.example .env
# El fichero .env NUNCA debe subirse a git (está en .gitignore).

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/comscore

# ─── TMDB API ─────────────────────────────────────────────────────────────────
# Obtén tu token de lectura en https://www.themoviedb.org/settings/api
# (sección "API Read Access Token")
TMDB_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# ─── Brave Search API (si se usa el scraper de búsqueda) ─────────────────────
BRAVE_API_KEY=tu_clave_aqui

# ─── Cloudflare Tunnel (si se usa en docker-compose) ─────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui

# ─── Flask ────────────────────────────────────────────────────────────────────
# En producción: FLASK_DEBUG=0, FLASK_ENV=production
FLASK_DEBUG=0
FLASK_ENV=production
